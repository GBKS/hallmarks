{
  "name": "hallmarks-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website for Hallmarks (hallmarks.info), built with Vite + Vue and prerendered to static HTML.",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "test-render": "node scripts/render-test.mjs",
    "verify": "npm run build && npm run test-render"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^26.1.0",
    "vite": "^6.0.7",
    "vite-ssg": "^0.24.1"
  }
}
